{
  "cyberpanel-safety-guard": {
    "enabled": false,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python hooks/cyberpanel_guard.py",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
