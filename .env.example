# ==============================================================================
# WP EDITORIAL STARTER KIT - ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. WordPress REST API Credentials (Role Administrator)
# ------------------------------------------------------------------------------
# Digunakan oleh agen AI untuk mengelola konten (pembuatan author, taksonomi, halaman statis, dan artikel)
# Dapatkan Application Password di: WP Admin -> Users -> Profile -> Application Passwords
WP_USERNAME=your_admin_username
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx

# ------------------------------------------------------------------------------
# 2. Easy MCP AI Token (Remote Model Context Protocol)
# ------------------------------------------------------------------------------
# Digunakan oleh agen untuk interaksi native WordPress tools via MCP endpoint:
# https://<your-domain>/wp-json/easy-mcp-ai/v1/mcp
EASY_MCP_AI_TOKEN=your_easy_mcp_ai_token

# ------------------------------------------------------------------------------
# 3. CyberPanel (OpenLiteSpeed) Server & API Credentials (Skill: wpsk-cyberpanel)
# ------------------------------------------------------------------------------
# Digunakan untuk provisi otomatis Virtual Host, database MySQL, upload core WP,
# dan perbaikan konfigurasi server tanpa setup manual.
# PENTING: Selalu matikan "API Access" di CyberPanel jika sedang tidak digunakan!
CYBERPANEL_URL=https://your-server-ip-or-domain:8090/
CYBERPANEL_USERNAME=your_cyberpanel_username
CYBERPANEL_PASSWORD=your_cyberpanel_password

# ------------------------------------------------------------------------------
# 4. Cloudflare DNS & Proxy API (Opsional)
# ------------------------------------------------------------------------------
# Digunakan untuk manajemen DNS record otomatis saat pointing domain/subdomain
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id
